# Copy to .env.local and fill in the Supabase `dev` project (excel-practice-dev),
# never `prod` (AD-13). Values: Supabase dashboard > Project Settings > API.
# Public values only; secret / service-role keys never go in this file.
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
