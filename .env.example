# Copy to .env.local and fill in the Supabase `dev` project (excel-practice-dev),
# never `prod` (AD-13). Values: Supabase dashboard > Project Settings > API.
# Placeholders only: real values, and above all the secret key, never go in the repo.
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server-only (no NEXT_PUBLIC_): the one Google account allowed to sign in
# (CAP-17). Same value as the row in private.auth_allowlist on `dev`.
ALLOWED_EMAIL=your-google-account@gmail.com
# Server-only (no NEXT_PUBLIC_): the `dev` project's secret key (service role,
# AD-9). Used only by POST /api/submissions/macro to record the bridge proof.
# Copy it into .env.local yourself; never commit it.
SUPABASE_SECRET_KEY=your-dev-secret-key
